# Copy this file to .env and fill in your key. .env is in .gitignore: never commit it.

# Default provider: Google Gemini (free key from https://aistudio.google.com/apikey)
LLM_API_KEY=paste-your-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash

# Groq instead (free key from https://console.groq.com/keys); pick a current model that supports tool use:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=<model name from Groq's model list>

# OpenRouter instead (free models end in ":free"):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=<model name>:free

# Ollama on your own computer (small models are unreliable at calling tools):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=<model you pulled>
